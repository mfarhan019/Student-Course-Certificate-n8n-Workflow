        "sendTo": "={{ $('Set Required Fields').item.json.Email }}",
        "subject": "=🎉 Congratulations {{ $('Set Required Fields').item.json.Name }}! Your Python Mastery Course Certificate",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Python Mastery Course - Certificate</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#0a0e17;font-family:Segoe UI,Arial,Helvetica,sans-serif;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#0a0e17;padding:24px 12px;\">\n  <tr>\n    <td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background-color:#111827;border:1px solid #1f2937;border-radius:14px;overflow:hidden;\">\n\n        <!-- Header -->\n        <tr>\n          <td align=\"center\" style=\"padding:28px 24px;background-color:#16303a;background-image:linear-gradient(135deg,#10252b,#2a4f5c);border-bottom:1px solid #1f2937;\">\n            <div style=\"font-size:12px;letter-spacing:2px;color:#4ade80;font-weight:700;\">FIZZ ACADEMY</div>\n            <div style=\"font-size:24px;color:#ffffff;font-weight:800;margin-top:10px;\">🐍 Python Mastery Course</div>\n          </td>\n        </tr>\n\n        <!-- Body -->\n        <tr>\n          <td style=\"padding:24px;\">\n\n            <!-- Banner -->\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#12271f;border:1px solid #1f7a4a;border-radius:10px;\">\n              <tr>\n                <td align=\"center\" style=\"padding:20px;font-size:19px;font-weight:800;color:#4ade80;\">\n                  🎉 Congratulations, You Passed!\n                </td>\n              </tr>\n            </table>\n\n            <p style=\"color:#e5e7eb;font-size:14px;font-weight:600;margin:28px 0 12px;\">\n              Hi <span style=\"color:#60a5fa;\">{{ $('Set Required Fields').item.json.Name }}</span>,\n            </p>\n\n            <p style=\"color:#9ca3af;font-size:13px;line-height:1.7;margin:0 0 20px;\">\n              Well done! You have successfully passed the <strong style=\"color:#ffffff;\">Python Mastery Course</strong>\n              certification test. Your hard work and consistency have paid off, and we are proud of your achievement.\n              Your <strong style=\"color:#ffffff;\">certificate is attached to this email.</strong>\n            </p>\n\n            <!-- Result details -->\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#0b1019;border:1px solid #1f2937;border-radius:10px;\">\n              <tr>\n                <td style=\"padding:18px 20px;font-size:13px;line-height:2.1;color:#9ca3af;\">\n                  <div>📘 <strong style=\"color:#60a5fa;\">Course:</strong> Python Mastery Course</div>\n                  <div>📝 <strong style=\"color:#60a5fa;\">Total Questions:</strong> 10 MCQs</div>\n                  <div>🎯 <strong style=\"color:#60a5fa;\">Your Score:</strong> <span style=\"color:#4ade80;font-weight:700;\">{{ $('Set Required Fields').item.json.Score }}</span></div>\n                  <div>📆 <strong style=\"color:#60a5fa;\">Issue Date:</strong> {{ $now.setZone('Asia/Karachi').toFormat('d MMMM, yyyy') }}</div>\n                  <div>🏆 <strong style=\"color:#60a5fa;\">Verdict:</strong> <span style=\"color:#4ade80;font-weight:700 $('Set Required Fields').item.json.Verdict }}</span></div>\n                </td>\n              </tr>\n            </table>\n\n            <!-- Attachment note -->\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#0f1a2e;border:1px dashed #3b82f6;border-radius:10px;margin-top:20px;\">\n              <tr>\n                <td align=\"center\" style=\"padding:16px;font-size:13px;color:#93c5fd;\">\n                  📎 Your certificate is attached to this email as a PDF.\n                </td>\n              </tr>\n            </table>\n\n            <p style=\"color:#9ca3af;font-size:13px;line-height:1.7;margin:22px 0 0;\">\n              You can download it, print it, and share it on LinkedIn or add it to your CV. Keep learning and keep building.\n            </p>\n\n          </td>\n        </tr>\n\n        <!-- Footer -->\n        <tr>\n          <td align=\"center\" style=\"padding:8px 24px 28px;\">\n            <div style=\"color:#6b7280;font-size:12px;\">Congratulations again, {{ $json.Student_Name }} - we are proud of you. 🏅</div>\n            <div style=\"color:#4b5563;font-size:11px;margin-top:6px;\">© 2026 Fizz Academy. All rights reserved.</div>\n          </td>\n        </tr>\n\n      </table>\n    </td>\n  </tr>\n</table>\n</body>\n</html>",

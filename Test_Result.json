        "subject": "={{ $json['Name: '] }}, your Python Mastery Course test result",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Python Mastery Course - Test Result</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#0a0e17;font-family:Segoe UI,Arial,Helvetica,sans-serif;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#0a0e17;padding:24px 12px;\">\n  <tr>\n    <td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background-color:#111827;border:1px solid #1f2937;border-radius:14px;overflow:hidden;\">\n\n        <!-- Header -->\n        <tr>\n          <td align=\"center\" style=\"padding:28px 24px;background-color:#16303a;background-image:linear-gradient(135deg,#10252b,#2a4f5c);border-bottom:1px solid #1f2937;\">\n            <div style=\"font-size:12px;letter-spacing:2px;color:#4ade80;font-weight:700;\">FIZZ ACADEMY</div>\n            <div style=\"font-size:24px;color:#ffffff;font-weight:800;margin-top:10px;\">🐍 Python Mastery Course</div>\n          </td>\n        </tr>\n\n        <!-- Body -->\n        <tr>\n          <td style=\"padding:24px;\">\n\n            <!-- Banner -->\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#2a2417;border:1px solid #b45309;border-radius:10px;\">\n              <tr>\n                <td align=\"center\" style=\"padding:20px;font-size:19px;font-weight:800;color:#fbbf24;\">\n                  📋 Your Test Result Is Ready\n                </td>\n              </tr>\n            </table>\n\n            <p style=\"color:#e5e7eb;font-size:14px;font-weight:600;margin:28px 0 12px;\">\n              Hi <span style=\"color:#60a5fa;\">{{ $json['Name: '] }}</span>,\n            </p>\n\n            <p style=\"color:#9ca3af;font-size:13px;line-height:1.7;margin:0 0 20px;\">\n              Thank you for attempting the <strong style=\"color:#ffffff;\">Python Mastery Course</strong> certification test.\n              Unfortunately, you did not reach the passing score this time. Please don't be disappointed. Every strong programmer\n              has needed more than one try, and <strong style=\"color:#ffffff;\">you will be given another chance very soon.</strong>\n            </p>\n\n            <!-- Result details -->\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#0b1019;border:1px solid #1f2937;border-radius:10px;\">\n              <tr>\n                <td style=\"padding:18px 20px;font-size:13px;line-height:2.1;color:#9ca3af;\">\n                  <div>📘 <strong style=\"color:#60a5fa;\">Course:</strong> Python Mastery Course</div>\n                  <div>📝 <strong style=\"color:#60a5fa;\">Total Questions:</strong> 10 MCQs</div>\n                  <div>🎯 <strong style=\"color:#60a5fa;\">Your Score:</strong> <span style=\"color:#fbbf24;font-weight:700;\">{{ $json.score }}</span></div>\n                  <div>✅ <strong style=\"color:#60a5fa;\">Passing Score:</strong> 7/10</div>\n                  <div>📌 <strong style=\"color:#60a5fa;\">Verdict:</strong> <span style=\"color:#f87171;font-weight:700;\">{{ $json.Verdict }}</span></div>\n                </td>\n              </tr>\n            </table>\n\n            <p style=\"color:#9ca3af;font-size:13px;line-height:1.7;margin:22px 0 8px;\">\n              <strong style=\"color:#e5e7eb;\">What you can do before the next attempt:</strong>\n            </p>\n            <ul style=\"color:#9ca3af;font-size:13px;line-height:1.9;margin:0 0 20px;padding-left:20px;\">\n              <li>Revise the topics where you lost marks.</li>\n              <li>Practice writing small Python programs every day.</li>\n              <li>Re-watch the lectures you found difficult.</li>\n            </ul>\n\n            <p style=\"color:#9ca3af;font-size:13px;line-height:1.7;margin:0 0 24px;\">\n              We will email you the details of your new test date shortly.\n            </p>\n\n            <!-- Button -->\n            <table role=\"presentation\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\">\n              <tr>\n                <td align=\"center\" style=\"border-radius:8px;background-color:#3b82f6;background-image:linear-gradient(90deg,#3b82f6,#22c55e);\">\n                  <a href=\"#\" style=\"display:inline-block;padding:14px 34px;font-size:14px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;\">📚 Review Course Material</a>\n                </td>\n              </tr>\n            </table>\n\n          </td>\n        </tr>\n\n        <!-- Footer -->\n        <tr>\n          <td align=\"center\" style=\"padding:8px 24px 28px;\">\n            <div style=\"color:#6b7280;font-size:12px;\">Keep going, {{ $json.Student_Name }} - you can do this. 💪</div>\n            <div style=\"color:#4b5563;font-size:11px;margin-top:6px;\">© 2026 Fizz Academy. All rights reserved.</div>\n          </td>\n        </tr>\n\n      </table>\n    </td>\n  </tr>\n</table>\n</body>\n</html>",

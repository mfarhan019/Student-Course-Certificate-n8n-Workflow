      "name": "Filter Original Students"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\n// Trigger node ke saare items (enrollment data)\nconst triggerItems = $('Get Enrolled Students').all();\n\n// Date parse karne ka function (DD/MM/YYYY aur normal formats dono)\nfunction parseDate(value) {\n  if (!value) return null;\n  const s = String(value).trim();\n\n  // DD/MM/YYYY ya DD-MM-YYYY\n  const m = s.match(/^(\\d{1,2})[\\/\\-.](\\d{1,2})[\\/\\-.](\\d{4})/);\n  if (m) return new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1]));\n\n  const d = new Date(s);\n  return isNaN(d.getTime()) ? null : d;\n}\n\nconst clean = (v) => String(v ?? '').trim().toLowerCase();\n\n// If1 se aane wale items (jinhon ne enrollment aur test dono diya)\nfor (const item of $input.all()) {\n  const testRow = item.json;\n\n  const email = clean(testRow['Email: ']);\n  const name = clean(testRow['Name: ']);\n\n  // Trigger mein se is student ka row dhoondo\n  const trigger = triggerItems.find(t =>\n    clean(t.json.Student_Email) === email &&\n    clean(t.json.Student_Name) === name\n  );\n\n  if (!trigger) continue;\n\n  // Enrollment date (column ka naam apni sheet ke mutabiq badal lein)\n  const rawDate = trigger.json.Date ?? trigger.json.Enrollment_Date;\n  const enrollmentDate = parseDate(rawDate);\n\n  if (!enrollmentDate) continue;\n\n  enrollmentDate.setHours(0, 0, 0, 0);\n\n  const diffDays = Math.round((today - enrollmentDate) / (1000 * 60 * 60 * 24));\n\n  // Sirf 30 ya zyada din wale aage jayein\n  if (diffDays >= 30) {\n    results.push({\n      json: {\n        ...testRow,\n        Student_Name: trigger.json.Student_Name,\n        Student_Email: trigger.json.Student_Email,\n        enrollment_date: rawDate,\n        days_passed: diffDays,\n        eligibility: \"Eligible\"\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        -304
      ],
      "id": "6a40a144-e3e4-4822-8e00-9f941df9cd0e",
      "name": "Check Eligibility"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\n// Har question ke liye: keyword (column ke naam mein hona chahiye) aur sahi jawab\n// Keywords apne Form ke question text ke mutabiq badal lein\nconst answerKey = [\n  { id: \"q1\",  keyword: \"q1\",  correct: \"def\" },\n  { id: \"q2\",  keyword: \"q2\",  correct: \"<class 'int'>\" },\n  { id: \"q3\",  keyword: \"q3\",  correct: \"#\" },\n  { id: \"q4\",  keyword: \"q4\",  correct: \"list = [1, 2, 3]\" },\n  { id: \"q5\",  keyword: \"q5\",  correct: \"6\" },\n  { id: \"q6\",  keyword: \"q6\",  correct: \"for\" },\n  { id: \"q7\",  keyword: \"q7\",  correct: \".py\" },\n  { id: \"q8\",  keyword: \"q8\",  correct: \"list\" },\n  { id: \"q9\",  keyword: \"q9\",  correct: \"1\" },\n  { id: \"q10\", keyword: \"q10\", correct: \"input()\" }\n];\n\n// Text ko normalize karo: lowercase, extra spaces, quotes ek jaise\nconst norm = (v) =>\n  String(v ?? \"\")\n    .replace(/[\\u2018\\u2019]/g, \"'\")\n    .replace(/[\\u201C\\u201D]/g, '\"')\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .toLowerCase();\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  const keys = Object.keys(data);\n\n  let marks = 0;\n  const breakdown = {};\n\n  answerKey.forEach((q, index) => {\n    // 1) Column naam mein keyword dhoondo (q1, q2... ya question text)\n    let col = keys.find(k => norm(k) === norm(q.keyword));\n\n    // 2) Na mile to question ka number (1-based) ya \"1.\" / \"Q1\" wali pattern try karo\n    if (!col) {\n      const n = index + 1;\n      const re = new RegExp(`^(q|question)?\\\\s*${n}\\\\s*[\\\\.\\\\):\\\\-]`, \"i\");\n      col = keys.find(k => re.test(k.trim()));\n    }\n\n    const studentAnswer = col ? norm(data[col]) : \"\";\n    const isCorrect = studentAnswer === norm(q.correct);\n\n    breakdown[q.id] = isCorrect ? \"Correct\" : \"Wrong\";\n    if (isCorrect) marks++;\n  });\n\n  results.push({\n    json: {\n      ...data,\n      ...breakdown,\n      marks: marks,\n      total: 10,\n      score: `${marks}/10`,\n      Verdict: marks >= 7 ? \"Pass\" : \"Fail\"\n    }\n  });\n}\n\nreturn results;"
      },

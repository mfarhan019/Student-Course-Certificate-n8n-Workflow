        "subject": "=🎉 Welcome {{ $json.name }}! Your Course Enrollment is Confirmed",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Welcome to the Course!</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#0a0e17; font-family: Arial, Helvetica, sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#0a0e17; padding:30px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#111827; border-radius:14px; overflow:hidden; border:1px solid #1f2a3d; box-shadow:0 0 35px rgba(0,200,255,0.15);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #0f2027, #203a43, #2c5364); padding:35px 30px; text-align:center; border-bottom:1px solid #1f2a3d;\">\n              <p style=\"margin:0 0 8px; font-size:13px; letter-spacing:2px; color:#4ade80; text-transform:uppercase; font-weight:bold;\">Fizz Academy</p>\n              <h1 style=\"margin:0; font-size:25px; color:#ffffff; font-weight:800; text-shadow:0 0 15px rgba(59,130,246,0.6);\">🎉 Welcome, {{ $json.name }}!</h1>\n              <p style=\"margin:10px 0 0; font-size:14px; color:#9ca3af;\">Your enrollment is confirmed</p>\n            </td>\n          </tr>\n\n          <!-- Glowing Success Banner -->\n          <tr>\n            <td style=\"padding:30px 30px 0;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(74,222,128,0.15)); border:1px solid rgba(74,222,128,0.4); border-radius:12px; box-shadow:0 0 20px rgba(74,222,128,0.15);\">\n                <tr>\n                  <td style=\"padding:22px 25px; text-align:center;\">\n                    <p style=\"margin:0; font-size:18px; color:#4ade80; font-weight:800; text-shadow:0 0 10px rgba(74,222,128,0.5);\">✅ Seat Reserved Successfully!</p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:30px 30px 10px;\">\n              <p style=\"font-size:16px; color:#e5e7eb; line-height:1.7; margin:0 0 15px;\">\n                Hi <strong style=\"color:#60a5fa;\">{{ $json.name }}</strong>,\n              </p>\n              <p style=\"font-size:15px; color:#9ca3af; line-height:1.7; margin:0 0 20px;\">\n                Thank you for enrolling! We're thrilled to have you join us. Your payment has been successfully received and your seat is officially reserved.\n              </p>\n\n              <!-- Test Unlock Date Highlight -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(74,222,128,0.1)); border:1px solid rgba(96,165,250,0.4); border-radius:12px; margin-bottom:25px; box-shadow:0 0 15px rgba(59,130,246,0.15);\">\n                <tr>\n                  <td style=\"padding:18px 25px; text-align:center;\">\n                    <p style=\"margin:0 0 6px; font-size:14px; color:#9ca3af;\">📌 Your certification test unlocks <strong style=\"color:#ffffff;\">30 days</strong> after enrollment</p>\n                    <p style=\"margin:0; font-size:17px; color:#4ade80; font-weight:800; text-shadow:0 0 10px rgba(74,222,128,0.4);\">🗓️ Test Unlock Date: {{ $now.plus({ days: 30 }).format('dd LLLL yyyy') }}</p>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Enrollment Details Card -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#0d1420; border-radius:10px; border:1px solid #1f2a3d; margin-bottom:25px;\">\n                <tr>\n                  <td style=\"padding:20px 25px;\">\n                    <p style=\"margin:0 0 12px; font-size:14px; color:#9ca3af;\"><strong style=\"color:#60a5fa;\">👤 Name:</strong> {{ $json.name }}</p>\n                    <p style=\"margin:0 0 12px; font-size:14px; color:#9ca3af;\"><strong style=\"color:#60a5fa;\">📧 Email:</strong> {{ $json.email }}</p>\n                    <p style=\"margin:0 0 12px; font-size:14px; color:#9ca3af;\"><strong style=\"color:#60a5fa;\">📱 Phone:</strong> {{ $json.phone_no }}</p>\n                    <p style=\"margin:0; font-size:14px; color:#9ca3af;\"><strong style=\"color:#60a5fa;\">📅 Enrollment Date:</strong> {{ $now.format('dd LLLL,y') }}</p>\n                  </td>\n                </tr>\n              </table>\n\n              <p style=\"font-size:15px; color:#9ca3af; line-height:1.7; margin:0 0 25px;\">\n                Next step: join our exclusive course community on WhatsApp to get updates, resources, and connect with fellow students 👇\n              </p>\n\n              <!-- Button -->\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 auto 25px;\">\n                <tr>\n                  <td align=\"center\" style=\"border-radius:8px; background: linear-gradient(135deg, #3b82f6, #22c55e); box-shadow:0 0 20px rgba(59,130,246,0.5);\">\n                    <a href=\"https://chat.whatsapp.com/JHG323456VGCHFtyfgnvc\" target=\"_blank\" style=\"display:inline-block; padding:16px 36px; font-size:16px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:8px;\">\n                      👉 Join Course Group\n                    </a>\n                  </td>\n                </tr>\n              </table>\n\n              <p style=\"font-size:13px; color:#6b7280; line-height:1.6; margin:0; text-align:center;\">\n                Stay active in the group — reminders and updates will be sent as your test date approaches!\n              </p>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:25px 30px 35px; text-align:center;\">\n              <p style=\"margin:0 0 6px; font-size:13px; color:#6b7280;\">Need help? Just reply to this email — we're here for you.</p>\n              <p style=\"margin:0; font-size:12px; color:#4b5563;\">© 2026 Fizz Academy. All rights reserved.</p>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
